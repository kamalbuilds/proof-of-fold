@@ -0,0 +1,35 @@
+# Merkle pull claim
+
+Reward payouts without a payout transaction per recipient. An operator publishes one Merkle root per epoch, and each recipient (or anyone relaying for them) claims their own leaf against it. Two contracts carry it.
+
+- [`RootRegistry.scash`](RootRegistry.scash) holds the roots. Two of three operator keys propose a root, the root then sits in a public audit window of `rootDelay` blocks, and anyone may activate it once the window has passed. The window is `require(this.age >= rootDelay)` on the registry's own UTXO, so the chain enforces it and no key can shorten it. A separate guardian key can cancel a pending root but can never propose one. Each proposal also pins the SHA-256 of the source data the root was built from, so anyone can re-fetch it, rebuild the tree and compare.
+- [`FoldClaimPool.scash`](FoldClaimPool.scash) holds the reward tokens and pays leaves of the registry's active root. It reads the registry through an `IRootRegistry` interface, copies the active root with `syncRoot()`, and verifies a Merkle proof in script. A leaf pays `cumulative - already claimed`, so a recipient may skip epochs, and the `claimed` mapping is the receipt that stops a second payout.
+
+A leaf is `sha256(0x00 | method | identity | cumulative as 8 bytes)` and an inner node is `sha256(0x01 | left | right)`.
+
+| Method | Identity | Who submits | Where the tokens go |
+| --- | --- | --- | --- |
+| 0 | a locking bytecode | anyone | exactly that locking bytecode |
+| 1 | the hash160 of a public key | the key holder signs | the destination the signature covers |
+
+Method 1 lets a recipient who only has a legacy P2PKH key claim to a token-aware address: the signature is the link between the two. After a root has been active for `pushDelay` blocks the registry opens a push window, and the pool's operator key may pay leaves that never claimed, to their own identity, above a minimum payout.
+
+[`merkle.ts`](merkle.ts) builds the tree and the proofs off-chain and agrees byte for byte with the contract.
+
+## Activating a root
+
+`activateRoot()` checks `this.age`, which is `OP_CHECKSEQUENCEVERIFY` on the registry's master input, so the call sets that input's sequence:
+
+```ts
+await registry.call.activateRoot().setSequence(rootDelay).send();
+```
+
+A smaller sequence is refused by the VM, and a larger one holds the spend until the registry UTXO is that old.
+
+## Tests
+
+```bash
+yarn workspace testing-suite test merkle_pull_claim
+```
+
+[`../testing-suite/test/merkle_pull_claim.test.ts`](../testing-suite/test/merkle_pull_claim.test.ts) compiles both contracts and runs the whole flow on the mock network: the audit window, a guardian cancel, claims by a stranger, forged claims, cumulative top-ups across epochs, and a method 1 claim.
diff --git a/examples/merkle_pull_claim/RootRegistry.scash b/examples/merkle_pull_claim/RootRegistry.scash
new file mode 100644
index 000000000..8e1be11e0
--- /dev/null
+++ b/examples/merkle_pull_claim/RootRegistry.scash
@@ -0,0 +1,80 @@
+pragma solidcash ^0.51.0;
+
+event Proposed(int indexed epoch, bytes32 root, bytes32 snapshot);
+event Activated(int indexed epoch, bytes32 root);
+event Cancelled(int indexed epoch);
+event PushOpened(int indexed epoch);
+
+error NotPending();
+error AuditWindowOpen(int needed);
+error EpochNotIncreasing(int epoch, int floor);
+error AlreadyPending(int epoch);
+
+enum Status { Idle, Pending }
+
+// RootRegistry: where FoldClaimPool learns which Merkle root to pay against.
+//
+// A root is proposed by two of three operator keys, then sits in a public audit window of ROOT_DELAY blocks
+// (a relative timelock on this contract's own UTXO, checked by the chain, so no key can shorten it). During the
+// window a separate guardian key can cancel the proposal but can never propose one. Activation is
+// permissionless once the window has passed. The window and the push delay are constructor arguments, fixed in the
+// contract address: the production profile is 144 and 4032 blocks, a demo profile can use fewer. Every proposal pins the SHA-256 of the exact F@H API response the
+// root was built from, so anyone can re-fetch it, rebuild the tree and compare.
+contract RootRegistry(pubkey op1, pubkey op2, pubkey op3, pubkey guardian, int rootDelay, int pushDelay) {
+
+    // The first three are read by FoldClaimPool through IRootRegistry: keep their order.
+    bytes32 public activeRoot;
+    int public activeEpoch;
+    int public pushEpoch;               // epoch whose root has been active long enough for operator push
+    bytes32 public activeSnapshot;
+    Status public status;
+    bytes32 public pendingRoot;
+    int public pendingEpoch;
+    bytes32 public pendingSnapshot;
+    int public highEpoch;               // highest epoch ever proposed, cancelled ones included
+
+    modifier twoOfThree(sig a, sig b) {
+        require(checkMultiSig([a, b], [op1, op2, op3]));
+        _;
+    }
+
+    modifier onlyGuardian(sig g) {
+        require(checkSig(g, guardian));
+        _;
+    }
+
+    function proposeRoot(sig a, sig b, bytes32 root, bytes32 snapshot, int epoch) twoOfThree(a, b) {
+        require(this.status == Status.Idle, AlreadyPending(this.pendingEpoch));
+        require(epoch > this.highEpoch, EpochNotIncreasing(epoch, this.highEpoch));
+        this.pendingRoot = root;
+        this.pendingSnapshot = snapshot;
+        this.pendingEpoch = epoch;
+        this.highEpoch = epoch;
+        this.status = Status.Pending;
+        emit Proposed(epoch, root, snapshot);
+    }
+
+    function cancelPending(sig g) onlyGuardian(g) {
+        require(this.status == Status.Pending, NotPending());
+        this.status = Status.Idle;
+        emit Cancelled(this.pendingEpoch);
+    }
+
+    function activateRoot() {
+        require(this.status == Status.Pending, NotPending());
+        require(this.age >= rootDelay, AuditWindowOpen(rootDelay));
+        this.activeRoot = this.pendingRoot;
+        this.activeSnapshot = this.pendingSnapshot;
+        this.activeEpoch = this.pendingEpoch;
+        this.status = Status.Idle;
+        emit Activated(this.pendingEpoch, this.pendingRoot);
+    }
+
+    function openPush() {
+        require(this.status == Status.Idle, "a proposal is pending");
+        require(this.activeEpoch > this.pushEpoch, "push already open for this epoch");
+        require(this.age >= pushDelay, AuditWindowOpen(pushDelay));
+        this.pushEpoch = this.activeEpoch;
+        emit PushOpened(this.activeEpoch);
+    }
+}
