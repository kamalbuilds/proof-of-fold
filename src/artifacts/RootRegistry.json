  "source": "pragma solidcash ^0.50.0;\n\nevent Proposed(int indexed epoch, bytes32 root, bytes32 snapshot);\nevent Activated(int indexed epoch, bytes32 root);\nevent Cancelled(int indexed epoch);\nevent PushOpened(int indexed epoch);\n\nerror NotPending();\nerror AuditWindowOpen(int needed);\nerror EpochNotIncreasing(int epoch, int floor);\nerror AlreadyPending(int epoch);\n\nenum Status { Idle, Pending }\n\n// RootRegistry: where FoldClaimPool learns which Merkle root to pay against.\n//\n// A root is proposed by two of three operator keys, then sits in a public audit window of ROOT_DELAY blocks\n// (a relative timelock on this contract's own UTXO, checked by the chain, so no key can shorten it). During the\n// window a separate guardian key can cancel the proposal but can never propose one. Activation is\n// permissionless once the window has passed. The window and the push delay are constructor arguments, fixed in the\n// contract address: the production profile is 144 and 4032 blocks, a demo profile can use fewer. Every proposal pins the SHA-256 of the exact F@H API response the\n// root was built from, so anyone can re-fetch it, rebuild the tree and compare.\ncontract RootRegistry(pubkey op1, pubkey op2, pubkey op3, pubkey guardian, int rootDelay, int pushDelay) {\n\n    // The first three are read by FoldClaimPool through IRootRegistry: keep their order.\n    bytes32 public activeRoot;\n    int public activeEpoch;\n    int public pushEpoch;               // epoch whose root has been active long enough for operator push\n    bytes32 public activeSnapshot;\n    Status public status;\n    bytes32 public pendingRoot;\n    int public pendingEpoch;\n    bytes32 public pendingSnapshot;\n    int public highEpoch;               // highest epoch ever proposed, cancelled ones included\n\n    modifier twoOfThree(sig a, sig b) {\n        require(checkMultiSig([a, b], [op1, op2, op3]));\n        _;\n    }\n\n    modifier onlyGuardian(sig g) {\n        require(checkSig(g, guardian));\n        _;\n    }\n\n    function proposeRoot(sig a, sig b, bytes32 root, bytes32 snapshot, int epoch) twoOfThree(a, b) {\n        require(this.status == Status.Idle, AlreadyPending(this.pendingEpoch));\n        require(epoch > this.highEpoch, EpochNotIncreasing(epoch, this.highEpoch));\n        this.pendingRoot = root;\n        this.pendingSnapshot = snapshot;\n        this.pendingEpoch = epoch;\n        this.highEpoch = epoch;\n        this.status = Status.Pending;\n        emit Proposed(epoch, root, snapshot);\n    }\n\n    function cancelPending(sig g) onlyGuardian(g) {\n        require(this.status == Status.Pending, NotPending());\n        this.status = Status.Idle;\n        emit Cancelled(this.pendingEpoch);\n    }\n\n    function activateRoot() {\n        require(this.status == Status.Pending, NotPending());\n        require(this.age >= rootDelay, AuditWindowOpen(rootDelay));\n        this.activeRoot = this.pendingRoot;\n        this.activeSnapshot = this.pendingSnapshot;\n        this.activeEpoch = this.pendingEpoch;\n        this.status = Status.Idle;\n        emit Activated(this.pendingEpoch, this.pendingRoot);\n    }\n\n    function openPush() {\n        require(this.status == Status.Idle, \"a proposal is pending\");\n        require(this.activeEpoch > this.pushEpoch, \"push already open for this epoch\");\n        require(this.age >= pushDelay, AuditWindowOpen(pushDelay));\n        this.pushEpoch = this.activeEpoch;\n        emit PushOpened(this.activeEpoch);\n    }\n}\n",
